{
  "name": "Sakuio Theme",
  "short": "SakuioTheme",
  "description": "Sakuio 官方默认主题",
  "version": "1.0.0",
  "author": "Sakuio",
  "url": "https://github.com/sakuio-monitor/Sakuio-frontend",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": "Sakuio 设置",
    "data": [
      {
        "name": "基础设置",
        "type": "title"
      },
      {
        "key": "dataUpdateInterval",
        "name": "数据更新间隔",
        "type": "number",
        "default": 1,
        "help": "实时数据刷新间隔，单位：秒（默认 1 秒）"
      },
      {
        "key": "rpcTransportMode",
        "name": "RPC 连接模式",
        "type": "select",
        "default": "sse",
        "options": "sse,websocket,http",
        "help": "RPC 连接模式，默认 SSE；可选 SSE、WebSocket、HTTP 轮询"
      },
      {
        "key": "defaultViewMode",
        "name": "默认视图模式",
        "type": "select",
        "default": "card",
        "options": "card,list",
        "help": "节点列表的默认显示模式"
      },
      {
        "key": "showLoginButton",
        "name": "未登录状态显示登录按钮",
        "type": "switch",
        "default": true,
        "help": "控制未登录状态下是否显示登录按钮"
      },
      {
        "key": "showPingChartButton",
        "name": "显示延迟图表按钮",
        "type": "switch",
        "default": true,
        "help": "在节点卡片和列表中显示查看延迟图表的按钮"
      },
      {
        "key": "networkQualityPingTasks",
        "name": "网络质量探测任务",
        "type": "pingtasks",
        "default": "[]",
        "help": "网络质量列表展示的延迟探测任务，最多 6 个，表头为任务名称；留空则按 Sakuio 后台任务顺序取前 6 个"
      },
      {
        "key": "hideSingleGroupTab",
        "name": "单分组时隐藏 Tab",
        "type": "switch",
        "default": true,
        "help": "当只有一个分组时，隐藏分组选择标签页"
      },
      {
        "name": "卡片视图",
        "type": "title"
      },
      {
        "key": "lightCardContrast",
        "name": "亮色卡片高对比度",
        "type": "switch",
        "default": false,
        "help": "启用后，在亮色模式下为卡片添加阴影和边框，增强与背景的对比度"
      },
      {
        "key": "cardProgressLayout",
        "name": "卡片进度条布局",
        "type": "select",
        "default": "2col",
        "options": "1col,2col",
        "help": "节点卡片中进度条的布局方式：1col 为一行一列，2col 为一行两列"
      },
      {
        "key": "tagsInSeparateRow",
        "name": "标签单独一行显示",
        "type": "switch",
        "default": false,
        "help": "启用后，自定义标签和价格标签将在运行时间上方单独一行常驻显示，而非 hover 时显示"
      },
      {
        "key": "uptimeTagWrap",
        "name": "使用 Tag 包裹运行时间",
        "type": "switch",
        "default": false,
        "help": "启用后，运行时间将使用 Tag 组件包裹显示，使用紫色作为标签颜色"
      },
      {
        "key": "trafficSplitColor",
        "name": "流量统计分离颜色",
        "type": "switch",
        "default": true,
        "help": "启用后，Card 视图下流量进度条下方的流量统计将使用绿色（上行）和蓝色（下行）区分显示"
      },
      {
        "name": "列表视图",
        "type": "title"
      },
      {
        "key": "listRowHeight",
        "name": "行高度",
        "type": "string",
        "default": "",
        "help": "List 视图与资产/成本表格的统一行高度（如 60px、4rem），留空为 56px"
      },
      {
        "key": "listStatusStyle",
        "name": "状态显示样式",
        "type": "select",
        "default": "tag",
        "options": "tag,badge",
        "help": "List 视图中节点状态的显示样式：tag 为标签样式，badge 为徽章样式"
      },
      {
        "key": "listOfflineNodesLast",
        "name": "离线节点后置",
        "type": "switch",
        "default": false,
        "help": "开启后，列表视图在未点击列头排序时，离线节点显示在所有在线节点之后"
      },
      {
        "key": "listTagsStyle",
        "name": "标签显示样式",
        "type": "select",
        "default": "tag",
        "options": "tag,badge",
        "help": "List 视图中节点标签的显示样式：tag 为标签样式，badge 为徽章样式"
      },
      {
        "key": "listColumnGap",
        "name": "列间距",
        "type": "string",
        "default": "12px",
        "help": "List 视图各列之间的间距（如 12px、1rem）"
      },
      {
        "key": "listViewColumns",
        "name": "显示列",
        "type": "string",
        "default": "[\"status\",\"region\",\"name\",\"uptime\",\"tags\",\"os\",\"cpu\",\"mem\",\"disk\",\"traffic\",\"rate\"]",
        "help": "List 视图下显示的列，JSON 数组格式（ASN/厂商在节点名称下方；价格与自定义标签在 tags 列）"
      },
      {
        "key": "listColumnWidths",
        "name": "列宽度配置",
        "type": "string",
        "default": "{\"status\":\"76px\",\"region\":\"32px\",\"name\":\"minmax(200px, 1fr)\",\"uptime\":\"minmax(100px, 0.4fr)\",\"tags\":\"minmax(200px, 0.6fr)\",\"os\":\"250px\",\"cpu\":\"160px\",\"mem\":\"160px\",\"disk\":\"160px\",\"traffic\":\"160px\",\"rate\":\"80px\"}",
        "help": "List 视图各列宽度配置，JSON 对象格式"
      },
      {
        "key": "listColumnPadding",
        "name": "列内边距配置",
        "type": "string",
        "default": "{}",
        "help": "List 视图各列内边距配置，JSON 对象格式，格式参照 listColumnWidths"
      },
      {
        "key": "listColumnMargin",
        "name": "列外边距配置",
        "type": "string",
        "default": "{}",
        "help": "List 视图各列外边距配置，JSON 对象格式，格式参照 listColumnWidths"
      },
      {
        "name": "页面布局",
        "type": "title"
      },
      {
        "key": "fullWidth",
        "name": "占满屏幕宽度",
        "type": "switch",
        "default": false,
        "help": "启用后页面内容将占满整个屏幕宽度"
      },
      {
        "key": "maxPageWidth",
        "name": "最大页面宽度",
        "type": "string",
        "default": "1800px",
        "help": "页面内容的最大宽度（如 1800px、100rem）"
      },
      {
        "key": "fontFamily",
        "name": "字体",
        "type": "string",
        "default": "\"MiSans VF\", sans-serif",
        "help": "全局字体设置，多个字体用逗号分隔"
      },
      {
        "key": "numberFontFamily",
        "name": "数字字体",
        "type": "string",
        "default": "\"TCloud Number VF\", \"MiSans VF\", sans-serif",
        "help": "数字显示专用字体，用于数值展示（如 CPU、内存、流量等）"
      },
      {
        "name": "亮色模式主题",
        "type": "title"
      },
      {
        "key": "lightPrimaryColor",
        "name": "主色调",
        "type": "string",
        "default": "#18a058",
        "help": "亮色模式主色调"
      },
      {
        "key": "lightPrimaryColorHover",
        "name": "主色调悬停色",
        "type": "string",
        "default": "#36ad6a",
        "help": "亮色模式按钮悬停颜色"
      },
      {
        "key": "lightPrimaryColorPressed",
        "name": "主色调按下色",
        "type": "string",
        "default": "#0c7a43",
        "help": "亮色模式按钮按下颜色"
      },
      {
        "name": "暗色模式主题",
        "type": "title"
      },
      {
        "key": "darkPrimaryColor",
        "name": "主色调",
        "type": "string",
        "default": "#63e2b6",
        "help": "暗色模式主色调"
      },
      {
        "key": "darkPrimaryColorHover",
        "name": "主色调悬停色",
        "type": "string",
        "default": "#7fe7c4",
        "help": "暗色模式按钮悬停颜色"
      },
      {
        "key": "darkPrimaryColorPressed",
        "name": "主色调按下色",
        "type": "string",
        "default": "#5acea7",
        "help": "暗色模式按钮按下颜色"
      },
      {
        "name": "格式化设置",
        "type": "title"
      },
      {
        "key": "byteDecimalsB",
        "name": "B 精确位数",
        "type": "number",
        "default": 0,
        "help": "字节数显示精确位数，-1 为不显示此单位"
      },
      {
        "key": "byteDecimalsKB",
        "name": "KB 精确位数",
        "type": "number",
        "default": 0,
        "help": "KB 显示精确位数，-1 为不显示此单位"
      },
      {
        "key": "byteDecimalsMB",
        "name": "MB 精确位数",
        "type": "number",
        "default": 1,
        "help": "MB 显示精确位数，-1 为不显示此单位"
      },
      {
        "key": "byteDecimalsGB",
        "name": "GB 精确位数",
        "type": "number",
        "default": 1,
        "help": "GB 显示精确位数，-1 为不显示此单位"
      },
      {
        "key": "byteDecimalsTB",
        "name": "TB+ 精确位数",
        "type": "number",
        "default": 2,
        "help": "TB 及以上单位显示精确位数，-1 为不显示此单位"
      },
      {
        "name": "公告设置",
        "type": "title"
      },
      {
        "key": "alertEnabled",
        "name": "启用公告",
        "type": "switch",
        "default": false,
        "help": "在首页显示自定义公告"
      },
      {
        "key": "alertType",
        "name": "公告类型",
        "type": "select",
        "default": "info",
        "options": "default,info,success,warning,error",
        "help": "公告的显示类型"
      },
      {
        "key": "alertTitle",
        "name": "公告标题",
        "type": "string",
        "default": "",
        "help": "公告的标题内容"
      },
      {
        "key": "alertContent",
        "name": "公告内容",
        "type": "richtext",
        "default": "",
        "help": "公告的详细内容（支持简单 Markdown 格式）"
      },
      {
        "name": "备案设置",
        "type": "title"
      },
      {
        "key": "icpEnabled",
        "name": "显示备案号",
        "type": "switch",
        "default": false,
        "help": "在页脚显示网站备案号"
      },
      {
        "key": "icpNumber",
        "name": "备案号",
        "type": "string",
        "default": "",
        "help": "网站备案号（如：京ICP备12345678号）"
      },
      {
        "key": "icpUrl",
        "name": "备案跳转链接",
        "type": "string",
        "default": "https://beian.miit.gov.cn/",
        "help": "点击备案号跳转的链接地址"
      },
      {
        "key": "policeEnabled",
        "name": "显示公安备案",
        "type": "switch",
        "default": false,
        "help": "在页脚显示公安备案信息"
      },
      {
        "key": "policeNumber",
        "name": "公安备案号",
        "type": "string",
        "default": "",
        "help": "公安备案号（如：京公网安备 11010502000000号）"
      },
      {
        "key": "policeUrl",
        "name": "公安备案跳转链接",
        "type": "string",
        "default": "",
        "help": "点击公安备案号跳转的链接地址，留空则不跳转"
      },
      {
        "name": "自定义背景",
        "type": "title"
      },
      {
        "key": "backgroundEnabled",
        "name": "启用自定义背景",
        "type": "switch",
        "default": false,
        "help": "启用后可设置自定义图片或视频作为页面背景"
      },
      {
        "key": "backgroundType",
        "name": "背景类型",
        "type": "select",
        "default": "image",
        "options": "image,video",
        "help": "选择背景类型：图片或视频"
      },
      {
        "key": "lightBackgroundUrl",
        "name": "亮色模式背景地址",
        "type": "string",
        "default": "",
        "help": "亮色模式下的背景图片/视频 URL"
      },
      {
        "key": "darkBackgroundUrl",
        "name": "暗色模式背景地址",
        "type": "string",
        "default": "",
        "help": "暗色模式下的背景图片/视频 URL"
      },
      {
        "key": "backgroundBlur",
        "name": "背景模糊半径",
        "type": "number",
        "default": 0,
        "help": "背景的高斯模糊半径（单位：px），0 表示不模糊"
      },
      {
        "key": "backgroundOverlay",
        "name": "背景遮罩透明度",
        "type": "number",
        "default": 0,
        "help": "背景遮罩层的透明度（0-100），0 表示无遮罩，数值越大遮罩越深"
      }
    ]
  }
}
