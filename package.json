{
  "name": "Sakuio-frontend",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:admin": "bun run --filter @sakuio/admin dev",
    "dev:public": "bun run --filter @sakuio/public dev",
    "build": "bun run --filter @sakuio/admin build && bun run --filter @sakuio/public build",
    "build:admin": "bun run --filter @sakuio/admin build",
    "build:public": "bun run --filter @sakuio/public build"
  },
  "license": "MIT"
}
